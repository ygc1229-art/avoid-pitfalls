# The domain must already point to the CVM public IP before Caddy requests HTTPS.
APP_DOMAIN=example.com

# Use `latest` for the newest main build or a full Git commit SHA for a pinned release.
APP_VERSION=latest

# Prefer a TencentDB PostgreSQL private-network address in the same VPC and region.
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/pitfalls

# Generate at least 32 random bytes. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Must match the public HTTPS address.
NEXT_PUBLIC_APP_URL=https://example.com

# Optional one-time bootstrap. Remove both values after the admin is created.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
