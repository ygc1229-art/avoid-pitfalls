# Full local mode: `docker compose up --build`
DATABASE_URL=postgresql://pitfalls:pitfalls@localhost:5432/pitfalls

# Use at least 32 random bytes in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional first local admin, created only by the seed command.
# Set both values together; use a strong password and remove them after setup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public base URL used for same-origin protection.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional identity providers. Their buttons stay visibly unavailable when blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMS_PROVIDER=
SMS_API_KEY=

# Optional object storage for future private evidence uploads.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
